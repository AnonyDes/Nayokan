# --- Site origins (public, no trailing slash). Dev defaults apply when unset. ---
# Production: https://nayokan.org, https://vti.nayokan.org, https://startup.nayokan.org, https://admin.nayokan.org
NEXT_PUBLIC_SITE_ORIGIN_CORPORATE=http://nayokan.localhost:3000
NEXT_PUBLIC_SITE_ORIGIN_VTI=http://vti.nayokan.localhost:3000
NEXT_PUBLIC_SITE_ORIGIN_STARTUP=http://startup.nayokan.localhost:3000
NEXT_PUBLIC_ADMIN_ORIGIN=http://admin.nayokan.localhost:3000

# --- Supabase (dev/test project; tests never run against production) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Secrets ---
PREVIEW_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
